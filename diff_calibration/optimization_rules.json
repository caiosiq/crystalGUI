{
    "__comment__": "OSOG Optimization Rules - The Brain of the Calibration Engine",

    "stages": {
        "geometry": {
            "name": "Geometry",
            "seed_mode": "locked",
            "freeze_others": true,
            "loss_weights": {"vgg": 1.0, "spectral": 10.0}
        },
        "texture": {
            "name": "Texture",
            "seed_mode": "locked",
            "freeze_others": true,
            "loss_weights": {"gram": 5000.0, "histogram": 10.0}
        },
        "fine_tune": {
            "name": "Fine-Tuning",
            "seed_mode": "locked",
            "freeze_others": false,
            "loss_weights": {"vgg": 1.0, "spectral": 10.0, "gram": 1000.0}
        }
    },
    
    "__comment_geometry__": "=== Geometry Parameters ===",
    
    "sensor.blur_sigma": {
        "bounds": [0.1, 10.0],
        "scale": "linear",
        "stage": "geometry",
        "lr_mult": 1.0
    },
    "sensor.bg_noise_std": {
        "bounds": [0.0, 50.0],
        "scale": "linear",
        "stage": "geometry",
        "lr_mult": 2.0
    },
    "optics.focus_z": {
        "bounds": [-30.0, 30.0],
        "scale": "linear",
        "stage": "geometry",
        "lr_mult": 2.0
    },
    "optics.aperture": {
        "bounds": [0.001, 1.0],
        "scale": "linear",
        "stage": "geometry",
        "lr_mult": 0.1
    },
    "optics.lighting_angle_deg": {
        "bounds": [0.0, 360.0],
        "scale": "linear",
        "stage": "geometry",
        "lr_mult": 5.0
    },
    "physics.rod_specs.length_min": {
        "bounds": [10.0, 150.0],
        "scale": "log",
        "stage": "geometry",
        "lr_mult": 5.0,
        "target_attr": ["physics.rod_specs.length_range", 0]
    },
    "physics.rod_specs.length_max": {
        "bounds": [50.0, 500.0],
        "scale": "log",
        "stage": "geometry",
        "lr_mult": 5.0,
        "target_attr": ["physics.rod_specs.length_range", 1]
    },
    
    "__comment_texture__": "=== Texture Parameters ===",
    
    "optics.noise_scale": {
        "bounds": [0.0, 2.0],
        "scale": "linear",
        "stage": "texture",
        "lr_mult": 0.5
    },
    "sensor.vignette_strength": {
        "bounds": [0.0, 1.0],
        "scale": "linear",
        "stage": "texture",
        "lr_mult": 0.1
    },
    "sensor.distractor_opacity": {
        "bounds": [0.0, 1.0],
        "scale": "linear",
        "stage": "texture",
        "lr_mult": 0.1
    },
    "physics.rod_specs.width_jit_amp": {
        "bounds": [0.0, 1.0],
        "scale": "linear",
        "stage": "texture",
        "lr_mult": 0.1
    }
}