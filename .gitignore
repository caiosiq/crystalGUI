# --- Generic ---
__pycache__/
*.py[cod]
*.swp
*.swo
.pytest_cache/
.DS_Store

# --- Local env and virtualenvs ---
.env
venv/
.venv/

# --- data: ignore runtime/generated contents by default ---
data/**

# Re-allow directories and .gitkeep placeholders
!data/**/
!data/**/.gitkeep

# Track shared OSOG synth presets (data/synth_presets/*.json)
!data/synth_presets/
!data/synth_presets/*.json

# Legacy training archive (datasets, runs, logs) — local only
data/legacy_training/

# --- models: ignore trained/local artifacts; track public releases + plugin templates ---
models/**
!models/public/
!models/public/**

# Built-in inference plugin templates (code only, no weights)
!models/example_blob/
!models/example_blob/**
!models/yolo_obb/
!models/yolo_obb/**
!models/yolo_speckle/
!models/yolo_speckle/**

# Explicit local-only model areas
models/legacy_training/
models/train_*/

# Weight files outside public/ (belt-and-suspenders)
models/**/*.pt
!models/public/**/*.pt
